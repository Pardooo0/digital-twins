# Plantilla: scripts/instalar.sh reemplaza __USUARIO__ y __DIR__ y la copia a /etc/systemd/system/
[Unit]
Description=Caja negra RPAS (GPS + DHT22 a CSV)
After=local-fs.target

[Service]
User=__USUARIO__
WorkingDirectory=__DIR__
ExecStart=__DIR__/.venv/bin/python -m cajanegra
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
